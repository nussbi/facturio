# facturio — environment variables (EXAMPLE ONLY — no real values)
# Copy to .env.local for local dev, or set as Worker secrets for production.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string      # HMAC key for session cookies (REQUIRED in prod)
DATABASE_URL=file:./prisma/dev.db                 # local SQLite; on Workers the D1 binding is used instead

# --- Public URLs ---
APP_BASE_URL=https://app.facturio.ch
SIGNING_BASE_URL=https://sign.facturio.ch
PUBLIC_BASE_URL=https://facturio.ch

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=facturio <emails@facturio.ch>
INVOICE_FROM_EMAIL=facturio <emails@facturio.ch>
RESET_FROM_EMAIL=facturio <emails@facturio.ch>
# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.facturio.ch/app/api/auth/google/callback

# --- SwissID OAuth ---
SWISSID_CLIENT_ID=
SWISSID_CLIENT_SECRET=
SWISSID_REDIRECT_URI=https://app.facturio.ch/app/api/auth/swissid/callback

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- App behaviour ---
DOWNLOAD_TTL_DAYS=30

# --- PostHog (public browser analytics) ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_LOGO_URL=
OPENPLZ_API_BASE=https://openplzapi.org
REMINDER_CRON_SECRET=                              # shared secret for the cron → reminders endpoint
INVOICE_ARCHIVE_SECRET=                            # HMAC for archived-invoice download links
STAGING_MODE=                                      # set to 1 on staging to skip real emails

# --- Cloudflare (deploy / R2 S3 API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
